# Copy this file to .env and fill in real values locally.
# .env is gitignored — never commit real values.
#
# Nothing here is required yet (the Steam downloader needs no credentials).
# This exists so future features (Phase 2+ app settings, Phase 3 platform
# integrations) have a consistent place to put local config instead of
# hardcoding paths/keys into scripts.

# Override the auto-detected ffmpeg binary location
# FFMPEG_PATH=F:\ffmpeg\bin\ffmpeg.exe

# Override the auto-detected yt-dlp binary location (Phase 3+)
# YTDLP_PATH=F:\ffmpeg\bin\yt-dlp.exe

# Default download output folder (Phase 2 app setting; falls back to the
# OS user Downloads folder if unset)
# DEFAULT_DOWNLOAD_DIR=

# Only if/when a platform integration requires an API key (e.g. a future
# official YouTube Data API key instead of yt-dlp scraping) — never hardcode
# these in source:
# YOUTUBE_API_KEY=
