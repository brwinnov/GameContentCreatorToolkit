# ── Secrets / local config ────────────────────────────────────────────────
.env
.env.local
*.env
!.env.example

# ── Logs ─────────────────────────────────────────────────────────────────
logs/*
!logs/.gitkeep

# ── Downloaded media / script output (never commit review-copy assets) ────
trailers/
images/
*_trailers/
NMS_trailers/
downloads/
dist/

