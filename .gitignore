# ── Secrets / local config ────────────────────────────────────────────────
.env
.env.local
*.env
!.env.example

# ── Logs ─────────────────────────────────────────────────────────────────
logs/*
!logs/.gitkeep

# ── Downloaded media / script output (never commit review-copy assets) ────
trailers/
images/
*_trailers/
NMS_trailers/
downloads/
dist/

# ── Local-only build/release outputs (keep on disk, do not track) ────────
release/
dist/
app/src-tauri/gen/

# ── Local editor / AI tool metadata ───────────────────────────────────────
.claude/
.vscode/
*.swp

# ── OS junk ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Future app build artifacts (Tauri / Node / Rust) ───────────────────
node_modules/
target/
src-tauri/target/
build/
out/
*.log

# ── PowerShell ──────────────────────────────────────────────────────────
*.ps1xml.bak
