.DS_Store
Thumbs.db
desktop.ini

# ── Editor ──────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
*.swp

# ── Future app build artifacts (Tauri / Node / Rust) ───────────────────
node_modules/
target/
src-tauri/target/
build/
out/
*.log

# ── PowerShell ──────────────────────────────────────────────────────────
*.ps1xml.bak
