{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GCCtoolkit",
  "version": "0.1.0",
  "identifier": "com.ackrosgaming.gcc",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Game Content Creator Toolkit",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "AckrosGaming",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "startMenuFolder": "AckrosGaming"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": false
    }
  }
}
