{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GCCtoolkit",
  "version": "0.1.4",
  "identifier": "com.ackrosgaming.gcc",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Game Content Creator Toolkit",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "AckrosGaming",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "1DDF37BF-062F-547C-A167-DAB5D7867081"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": false
    }
  }
}
